<Window x:Class="OmniDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniDeck" Height="820" Width="1280" MinHeight="700" MinWidth="1050"
        Background="#090B10" WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        FontFamily="Segoe UI"
        Icon="logo.PNG">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#121620"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#232A37"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8993A6"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#42E8F5"/>

        <Style x:Key="SidebarTabStyle" TargetType="TabItem">
            <Setter Property="Width" Value="190"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Foreground" Value="#929BAD"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="10" Margin="0,2">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" ContentSource="Header" Margin="14,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1A2530"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#2C5861"/>
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="#55EFF7"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1B202B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="Visibility" Value="Collapsed">
                                <Setter Property="Width" Value="0"/>
                                <Setter Property="Height" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1A202B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Width" Value="168"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="11" BorderBrush="#2C3543" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#202B37"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#42E8F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#111720"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GameButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="8"/>
        </Style>

        <Style x:Key="AppCardBorder" TargetType="Border">
            <Setter Property="Background" Value="#131923"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="#27313F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="7"/>
            <Setter Property="Width" Value="238"/>
        </Style>

        <Style x:Key="DownloadScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}" Opacity="0" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#00F2FE" CornerRadius="5" Margin="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}" Opacity="0" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppSelectBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#00F2FE"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CheckBorder" Width="16" Height="16" CornerRadius="4" BorderBrush="#46505F" BorderThickness="1" Background="#11151C" Margin="0,0,8,0">
                                <Path x:Name="CheckMark" Data="M 3,8 L 7,12 L 13,4" Stroke="#0D0E12" StrokeThickness="2" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#00F2FE"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#00F2FE"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#38EF7D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DownloadActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Width" Value="198"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="DownloadPrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#00D5DF"/>
            <Setter Property="Foreground" Value="#071014"/>
            <Setter Property="Width" Value="190"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimaryBorder" Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="#5DFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryBorder" Property="Background" Value="#38EF7D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PrimaryBorder" Property="Background" Value="#00AAB7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Rectangle Fill="#090B10"/>
        <Rectangle HorizontalAlignment="Right" VerticalAlignment="Top" Width="500" Height="400" Opacity="0.14" IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#1B788A" Offset="0"/>
                    <GradientStop Color="#090B10" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <TabControl x:Name="MainTabControl" TabStripPlacement="Left" Background="Transparent" BorderThickness="0" Margin="14">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource SidebarTabStyle}"/>
            </TabControl.Resources>
            <TabControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </TabControl.ItemsPanel>
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#0E1219" BorderBrush="#202733" BorderThickness="1" CornerRadius="18" Padding="12" Margin="0,0,16,0">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Top" Margin="8,10,8,26">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="38" Height="38" CornerRadius="11" Background="#16313A" BorderBrush="#27545C" BorderThickness="1">
                                            <TextBlock Text="O" Foreground="#54EDF5" FontSize="22" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="OMNIDECK" Foreground="White" FontSize="15" FontWeight="Bold"/>
                                            <TextBlock Text="GAMING CONTROL" Foreground="#657184" FontSize="9" FontWeight="Bold" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="WORKSPACE" Foreground="#566173" FontSize="10" FontWeight="Bold" Margin="4,28,0,9"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Bottom" Margin="8,16,8,6">
                                    <Border Height="1" Background="#242C39" Margin="0,0,0,14"/>
                                    <TextBlock Text="OMNIDECK  •  v1.0.4" Foreground="#657184" FontSize="10"/>
                                    <TextBlock Text="Made to make your life easier" Foreground="#465161" FontSize="10" Margin="0,4,0,0"/>
                                </StackPanel>
                                <ItemsPresenter/>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#0B0E14" BorderBrush="#1C232E" BorderThickness="1" CornerRadius="18" Padding="10">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <!-- BOČNI TAB 1: HOME -->
            <TabItem Header="⌂   Početna">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="10,4,8,4">
                    <StackPanel Margin="18,16,18,22">
                        <Border CornerRadius="18" Padding="26" Margin="0,0,0,16" BorderBrush="#29434B" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#17232E" Offset="0"/>
                                    <GradientStop Color="#131923" Offset="0.56"/>
                                    <GradientStop Color="#1A1B2A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Ellipse Width="8" Height="8" Fill="#49E59C" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="YOUR SETUP IS READY" Foreground="#8BA2AA" FontSize="10" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBlock Text="Dobrodošao natrag" Foreground="White" FontSize="26" FontWeight="Bold"/>
                                    <TextBlock x:Name="ClockText" Text="00:00:00" Foreground="#54EDF5" FontSize="46" FontWeight="Bold" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="DateText" Text="Učitavanje..." Foreground="#9BA7B9" FontSize="13" Margin="2,1,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Width="152" Height="152" CornerRadius="76" BorderBrush="#2C6670" BorderThickness="1" Background="#121D28" VerticalAlignment="Center" Margin="18,0,8,0">
                                    <Grid>
                                        <Ellipse Width="116" Height="116" Stroke="#243A48" StrokeThickness="1"/>
                                        <Ellipse Width="88" Height="88" Stroke="#2D7380" StrokeThickness="1"/>
                                        <TextBlock Text="OD" Foreground="#54EDF5" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Ellipse Width="9" Height="9" Fill="#54EDF5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,28,25,0"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#121720" CornerRadius="14" Padding="17" Margin="0,0,6,0" BorderBrush="#252E3B" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="PROCESSOR" Foreground="#788497" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="CpuText" Text="0%" Foreground="#54EDF5" FontSize="29" FontWeight="Bold" Margin="0,9,0,0"/>
                                    <TextBlock Text="CPU usage" Foreground="#606C7E" FontSize="10" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#121720" CornerRadius="14" Padding="17" Margin="3,0" BorderBrush="#252E3B" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="MEMORY" Foreground="#788497" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="RamText" Text="0%" Foreground="#55D69C" FontSize="29" FontWeight="Bold" Margin="0,9,0,0"/>
                                    <TextBlock Text="RAM usage" Foreground="#606C7E" FontSize="10" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#121720" CornerRadius="14" Padding="17" Margin="3,0" BorderBrush="#252E3B" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="GRAPHICS" Foreground="#788497" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="GpuText" Text="0%" Foreground="#E68BFF" FontSize="29" FontWeight="Bold" Margin="0,9,0,0"/>
                                    <TextBlock Text="GPU usage" Foreground="#606C7E" FontSize="10" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Background="#121720" CornerRadius="14" Padding="17" Margin="6,0,0,0" BorderBrush="#252E3B" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="STORAGE  •  C:" Foreground="#788497" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="DiskText" Text="N/A" Foreground="#FFC66E" FontSize="29" FontWeight="Bold" Margin="0,9,0,0"/>
                                    <TextBlock Text="disk in use" Foreground="#606C7E" FontSize="10" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*"/>
                                <ColumnDefinition Width="0.85*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#121720" CornerRadius="15" Padding="19" Margin="0,0,7,0" BorderBrush="#252E3B" BorderThickness="1">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="NETWORK" Foreground="#54EDF5" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock Text="Brzina interneta" Foreground="White" FontSize="19" FontWeight="Bold" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="SpeedTestButton" Grid.Column="1" Content="Pokreni test" Click="RunSpeedTest_Click" Style="{StaticResource ActionButton}" Width="126" Height="38" Margin="0" FontSize="11" ToolTipService.InitialShowDelay="0">
                                            <Button.ToolTip>
                                                <ToolTip Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0"
                                                        Placement="Mouse"
                                                        HorizontalOffset="12"
                                                        VerticalOffset="18">
                                            <Border Width="310"
                                                    Padding="15"
                                                    Background="#151C27"
                                                    BorderBrush="#31535F"
                                                    BorderThickness="1"
                                                    CornerRadius="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="#42E8F5" CornerRadius="2" Margin="0,2,0,2"/>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                    <TextBlock Text="Test brzine interneta"
                                                               Foreground="White"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="Ovo je malo kuhan sistem i download brzina ovisi do servera tu mozda bude neki 100-200 Mbps vise."
                                                               Foreground="#AAB5C5"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               LineHeight="18"
                                                               Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </ToolTip>
                                </Button.ToolTip>
                                </Button>
                                    </Grid>
                                    <TextBlock x:Name="SpeedTestStatusText" Text="Pokreni test za mjerenje veze." Foreground="#788497" FontSize="11" Margin="0,5,0,15"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="PING" Foreground="#788497" FontSize="9" FontWeight="Bold"/>
                                            <TextBlock x:Name="SpeedTestPingText" Text="—" Foreground="#54EDF5" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="DOWNLOAD" Foreground="#788497" FontSize="9" FontWeight="Bold"/>
                                            <TextBlock x:Name="SpeedTestDownloadText" Text="—" Foreground="#55D69C" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="UPLOAD" Foreground="#788497" FontSize="9" FontWeight="Bold"/>
                                            <TextBlock x:Name="SpeedTestUploadText" Text="—" Foreground="#FFC66E" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#121720" CornerRadius="15" Padding="19" Margin="7,0,0,0" BorderBrush="#252E3B" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="QUICK LAUNCH" Foreground="#E68BFF" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="Brzi alati" Foreground="White" FontSize="19" FontWeight="Bold" Margin="0,5,0,12"/>
                                    <WrapPanel>
                                        <Button Content="Task Manager" Click="OpenTaskManager_Click" Style="{StaticResource ActionButton}" Width="132" Height="38" Margin="0,0,6,6" FontSize="11"/>
                                        <Button Content="Kalkulator" Click="OpenCalculator_Click" Style="{StaticResource ActionButton}" Width="112" Height="38" Margin="0,0,0,6" FontSize="11"/>
                                        <Button Content="Notepad" Click="OpenNotepad_Click" Style="{StaticResource ActionButton}" Width="112" Height="38" Margin="0,0,6,0" FontSize="11"/>
                                        <Button Content="CMD Prompt" Click="OpenCMD_Click" Style="{StaticResource ActionButton}" Width="132" Height="38" Margin="0" FontSize="11"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="UptimeText" Text="Uptime: N/A" Foreground="#697589" FontSize="10" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- BOČNI TAB 2: GAMES -->
            <TabItem Header="▣   Igre">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="26">
                        <TextBlock Text="GAMING HUB" Foreground="#54EDF5" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="Igre i launcheri" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,6,0,4"/>
                        <TextBlock Text="Sve tvoje gaming prečice, spremne za pokretanje." Foreground="#8993A6" FontSize="13" Margin="0,0,0,22"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#131B27" BorderBrush="#29424D" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,7,0">
                                <StackPanel>
                                    <TextBlock Text="LIBRARY" Foreground="#54EDF5" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="Steam" Foreground="White" FontSize="23" FontWeight="Bold" Margin="0,7,0,3"/>
                                    <TextBlock Text="Pregledaj i pokreni instalirane igre." Foreground="#8993A6" FontSize="12" Margin="0,0,0,16"/>
                                    <Button Content="Otvori Steam biblioteku" Click="OpenSteamTab_Click" Style="{StaticResource ActionButton}" Width="220" HorizontalAlignment="Left" Margin="0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#191725" BorderBrush="#3A304D" BorderThickness="1" CornerRadius="16" Padding="22" Margin="7,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="GAME STORE" Foreground="#D99AFF" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="Epic Games" Foreground="White" FontSize="23" FontWeight="Bold" Margin="0,7,0,3"/>
                                    <TextBlock Text="Pokreni Epic Games Launcher." Foreground="#8993A6" FontSize="12" Margin="0,0,0,16"/>
                                    <Button Content="Pokreni Epic Games" Click="OpenEpic_Click" Style="{StaticResource ActionButton}" Width="200" HorizontalAlignment="Left" Margin="0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- SKRIVENI TAB: STEAM LIBRARY -->
            <TabItem x:Name="SteamTab" Header="◈   Steam biblioteka" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24,22,24,24">
                        <Button Content="←  Povratak na igre" Click="BackToGames_Click" Style="{StaticResource ActionButton}" Width="180" HorizontalAlignment="Left" Margin="0,0,0,20"/>
                        <TextBlock Text="STEAM LIBRARY" Foreground="#54EDF5" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="Tvoja biblioteka" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,6,0,4"/>
                        <TextBlock Text="Odaberi igru za pokretanje." Foreground="#8993A6" FontSize="13" Margin="0,0,0,20"/>
                        
                        <WrapPanel x:Name="SteamGamesPanel" HorizontalAlignment="Left">
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- BOČNI TAB 3: DOWNLOAD APPS -->
            <TabItem Header="⬇   Aplikacije">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="2,0,2,0">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource DownloadScrollBar}"/>
                    </ScrollViewer.Resources>
                    <StackPanel Margin="20,18,20,24">
                        <Border Background="#141D27" BorderBrush="#2A414B" BorderThickness="1" CornerRadius="16" Padding="24,22" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="APP VAULT  /  INSTALACIJA" Foreground="#54EDF5" FontSize="10" FontWeight="Bold"/>

<Window x:Class="OmniDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniDeck" Height="650" Width="1000"
        Background="#0D0E12" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Icon="logo.PNG">

    <Window.Resources>
        <!-- Stil za gumbe izbornika (Sidebar) -->
        <Style x:Key="SidebarTabStyle" TargetType="TabItem">
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{TemplateBinding Content}" FontSize="15" FontWeight="SemiBold" Margin="15,10"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#8A8F9E"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="8" Margin="0,4,0,4">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Left" ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1E2029"/>
                                <Setter Property="Foreground" Value="#00F2FE"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#161820"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stil za akcijske gumbove -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1E202A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Width" Value="160"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="#2A2D3A" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#282B38"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#00F2FE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#14151C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GameButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="8"/>
        </Style>

        <!-- Stil za kartice aplikacija u Download tabu -->
        <Style x:Key="AppCardBorder" TargetType="Border">
            <Setter Property="Background" Value="#14161E"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#222533"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Width" Value="280"/>
        </Style>
    </Window.Resources>

    <Grid>
        <TabControl x:Name="MainTabControl" TabStripPlacement="Left" Background="Transparent" BorderThickness="0" Margin="10">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource SidebarTabStyle}"/>
            </TabControl.Resources>

            <!-- BOČNI TAB 1: HOME -->
            <TabItem Header="  Home">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- ZAGLAVLJE SA SATOM -->
                        <Border Grid.Row="0" CornerRadius="16" Padding="30,20" Margin="0,0,10,15">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#161822" Offset="0.0"/>
                                    <GradientStop Color="#1A1C28" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="ClockText" Text="00:00:00" Foreground="#00F2FE" FontSize="52" FontWeight="Bold"/>
                                    <TextBlock x:Name="DateText" Text="Učitavanje..." Foreground="#7E859B" FontSize="14" Margin="2,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- STATUS KARTICE (CPU, RAM, GPU) -->
                        <Grid Grid.Row="1" Margin="0,0,10,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#14161E" CornerRadius="14" Padding="20" Margin="0,0,8,0" BorderBrush="#222533" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="CPU" Foreground="#6C7289" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock x:Name="CpuText" Text="0%" Foreground="#00F2FE" FontSize="32" FontWeight="Bold" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#14161E" CornerRadius="14" Padding="20" Margin="4,0,4,0" BorderBrush="#222533" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="RAM" Foreground="#6C7289" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock x:Name="RamText" Text="0%" Foreground="#38EF7D" FontSize="32" FontWeight="Bold" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#14161E" CornerRadius="14" Padding="20" Margin="8,0,0,0" BorderBrush="#222533" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="GPU" Foreground="#6C7289" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock x:Name="GpuText" Text="0%" Foreground="#FF5252" FontSize="32" FontWeight="Bold" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- BRZE AKCIJE -->
                        <Border Grid.Row="2" Background="#14161E" CornerRadius="14" Padding="20" Margin="0,0,10,0" BorderBrush="#222533" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Brzi Alati i Kontrole" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                                <WrapPanel>
                                    <Button Content="Task Manager" Click="OpenTaskManager_Click" Style="{StaticResource ActionButton}"/>
                                    <Button Content="Kalkulator" Click="OpenCalculator_Click" Style="{StaticResource ActionButton}"/>
                                    <Button Content="Restart PC" Click="RestartPC_Click" Style="{StaticResource ActionButton}"/>
                                    <Button Content="Shutdown PC" Click="ShutdownPC_Click" Style="{StaticResource ActionButton}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- BOČNI TAB 2: GAMES -->
            <TabItem Header="  Igre">
                <Grid Margin="20">
                    <StackPanel>
                        <TextBlock Text="Launcheri &amp; Igre" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                        <WrapPanel>
                            <Button Content="Steam Library" Click="OpenSteamTab_Click" Style="{StaticResource ActionButton}"/>
                            <Button Content="Epic Games" Click="OpenEpic_Click" Style="{StaticResource ActionButton}"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- SKRIVENI TAB: STEAM LIBRARY -->
            <TabItem x:Name="SteamTab" Header="  Steam Lib" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,0,0,0">
                    <StackPanel Margin="10">
                        <Button Content="← Povratak na Igre" Click="BackToGames_Click" Style="{StaticResource ActionButton}" Width="160" HorizontalAlignment="Left" Margin="0,0,0,15"/>
                        <TextBlock Text="Instalirane Steam Igre" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock Text="Klikni na igru za pokretanje." Foreground="#7E859B" FontSize="13" Margin="0,0,0,20"/>
                        
                        <WrapPanel x:Name="SteamGamesPanel" HorizontalAlignment="Left">
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- BOČNI TAB 3: DOWNLOAD APPS (NOVI TAB) -->
            <TabItem Header="  Download Apps">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,0,0,0">
                    <StackPanel Margin="10">
                        <TextBlock Text="Instalacija Aplikacija" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock Text="Instaliraj popularne programe direktno na računalo ili otvori web stranicu." Foreground="#7E859B" FontSize="13" Margin="0,0,0,20"/>

                        <WrapPanel>
                            <!-- Discord -->
                            <Border Style="{StaticResource AppCardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Discord" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="Komunikacija za gejmere i zajednice." Foreground="#7E859B" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,15"/>
                                    <Button Content="Instaliraj (Winget)" Click="InstallDiscord_Click" Style="{StaticResource ActionButton}" Width="240"/>
                                    <Button Content="Otvori Stranicu" Click="WebDiscord_Click" Style="{StaticResource ActionButton}" Width="240" Margin="6,5,6,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Steam -->
                            <Border Style="{StaticResource AppCardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Steam" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="Vodeća platforma za PC igre." Foreground="#7E859B" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,15"/>
                                    <Button Content="Instaliraj (Winget)" Click="InstallSteam_Click" Style="{StaticResource ActionButton}" Width="240"/>
                                    <Button Content="Otvori Stranicu" Click="WebSteam_Click" Style="{StaticResource ActionButton}" Width="240" Margin="6,5,6,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Google Chrome -->
                            <Border Style="{StaticResource AppCardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Google Chrome" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="Popularni web preglednik." Foreground="#7E859B" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,15"/>
                                    <Button Content="Instaliraj (Winget)" Click="InstallChrome_Click" Style="{StaticResource ActionButton}" Width="240"/>
                                    <Button Content="Otvori Stranicu" Click="WebChrome_Click" Style="{StaticResource ActionButton}" Width="240" Margin="6,5,6,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Brave Browser -->
                            <Border Style="{StaticResource AppCardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Brave Browser" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="Brzi preglednik usmjeren na privatnost." Foreground="#7E859B" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,15"/>
                                    <Button Content="Instaliraj (Winget)" Click="InstallBrave_Click" Style="{StaticResource ActionButton}" Width="240"/>
                                    <Button Content="Otvori Stranicu" Click="WebBrave_Click" Style="{StaticResource ActionButton}" Width="240" Margin="6,5,6,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Spotify -->
                            <Border Style="{StaticResource AppCardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Spotify" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="Slušanje glazbe i podcasta." Foreground="#7E859B" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,15"/>
                                    <Button Content="Instaliraj (Winget)" Click="InstallSpotify_Click" Style="{StaticResource ActionButton}" Width="240"/>
                                    <Button Content="Otvori Stranicu" Click="WebSpotify_Click" Style="{StaticResource ActionButton}" Width="240" Margin="6,5,6,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Visual Studio Code -->
                            <Border Style="{StaticResource AppCardBorder}">
                                <StackPanel>
                                    <TextBlock Text="VS Code" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="Uređivač koda za programere." Foreground="#7E859B" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,15"/>
                                    <Button Content="Instaliraj (Winget)" Click="InstallVSCode_Click" Style="{StaticResource ActionButton}" Width="240"/>
                                    <Button Content="Otvori Stranicu" Click="WebVSCode_Click" Style="{StaticResource ActionButton}" Width="240" Margin="6,5,6,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Zen Browser -->
                            <Border Style="{StaticResource AppCardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Zen Browser" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="We care about your experience, not your data." Foreground="#7E859B" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,15"/>
                                    <Button Content="Instaliraj (Winget)" Click="InstallZenBrowser_Click" Style="{StaticResource ActionButton}" Width="240"/>
                                    <Button Content="Otvori Stranicu" Click="WebZenBrowser_Click" Style="{StaticResource ActionButton}" Width="240" Margin="6,5,6,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Riot Client -->
                            <Border Style="{StaticResource AppCardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Riot Client" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="Nema link za download launchera" Foreground="#7E859B" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,15"/>
                                    <Button Content="Otvori Stranicu" Click="InstallRiotClient_Click" Style="{StaticResource ActionButton}" Width="240"/>
                                    <Button Content="Otvori Stranicu" Click="WebRiotClient_Click" Style="{StaticResource ActionButton}" Width="240" Margin="6,5,6,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Rockstar Games Launcher -->
                            <Border Style="{StaticResource AppCardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Rockstar Games Launcher" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="Pokretač za Rockstar Games naslove." Foreground="#7E859B" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,15"/>
                                    <Button Content="Instaliraj (Winget)" Click="InstallRockstarLauncher_Click" Style="{StaticResource ActionButton}" Width="240"/>
                                    <Button Content="Otvori Stranicu" Click="WebRockstarLauncher_Click" Style="{StaticResource ActionButton}" Width="240" Margin="6,5,6,0"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- BOČNI TAB 4: TOOLS -->
            <TabItem Header="  Alati">
                <Grid Margin="20">
                    <StackPanel>
                        <TextBlock Text="Sistemski Alati" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                        <WrapPanel>
                            <Button Content="The Ultimate Windows Utility" Click="OpenChrisutl_Click" Style="{StaticResource ActionButton}"/>
                            <Button Content="Win11Debloat" Click="OpenWin11Debloat_Click" Style="{StaticResource ActionButton}"/>
                            <Button Content="Kalkulator" Click="OpenCalculator_Click" Style="{StaticResource ActionButton}"/>
                            <Button Content="Notepad" Click="OpenNotepad_Click" Style="{StaticResource ActionButton}"/>
                            <Button Content="Task Manager" Click="OpenTaskManager_Click" Style="{StaticResource ActionButton}"/>
                            <Button Content="CMD Prompt" Click="OpenCMD_Click" Style="{StaticResource ActionButton}"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- BOČNI TAB 5: SETTINGS -->
            <TabItem Header="  Postavke">
                <Grid Margin="20">
                    <StackPanel>
                        <TextBlock Text="Postavke Aplikacije" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                        <Button Content="Windows Settings" Click="OpenSettings_Click" Style="{StaticResource ActionButton}" Width="200" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>